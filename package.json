{
  "name": "@atomicbytes/atoms",
  "version": "0.1.0",
  "description": "AtomicBytes design system component library - React components with mid-century atomic optimism",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.preset": "./dist/tailwind.preset.js",
    "./icons": {
      "import": "./dist/icons/index.js",
      "types": "./dist/icons/index.d.ts"
    },
    "./characters": {
      "import": "./dist/characters/index.js",
      "types": "./dist/characters/index.d.ts"
    },
    "./labels": {
      "import": "./dist/labels/index.js",
      "types": "./dist/labels/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "atomicbytes",
    "ui",
    "tailwind"
  ],
  "author": "AtomicBytes",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0"
}
